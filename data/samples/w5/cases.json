      "status": "READY",
      "request": {
        "report_type": "industry_analysis",
        "industry": "新能源汽车",
        "region": "中国",
        "period": {
          "from": "2022",
          "to": "2024"
        },
        "template_id": "industry_analysis_v1",
        "focus": [
          "市场规模",
          "政策环境",
          "趋势与挑战"
        ],
        "as_of": "2025-12-03"
      },
      "required_contract_indicators": [
        "sales"
      ],
      "metric_record_ids": [
        "r01-cn-nev-sales-2022",
        "r01-cn-nev-sales-2023",
        "r01-cn-nev-sales-2024"
      ],
      "evidence_keys": [
        "EV-R01-MIIT-2022-ANNUAL",
        "EV-R01-MIIT-2023-ANNUAL",
        "EV-R01-MEE-2024-P8",
        "EV-R01-POLICY-2021-2035"
      ],
      "expected_metrics": [
        {
          "source_metric_id": "r01-cn-nev-sales-2024",
          "period": "2024",
          "contract_indicator": "sales",
          "formula_id": "yoy_pct",
          "display_value": "35.50%",
          "unit": "%"
        }
      ],
      "expected_conclusions": [
        {
          "conclusion_key": "R01-market-growth",
          "text": "中国新能源汽车销量由2022年688.7万辆增至2024年1286.6万辆，2024年按原始值计算同比增长35.50%。",
          "evidence_keys": [
            "EV-R01-MIIT-2022-ANNUAL",
            "EV-R01-MIIT-2023-ANNUAL",
            "EV-R01-MEE-2024-P8"
          ],
          "allowed_wording": [
            "销量增长",
            "市场规模扩大",
            "同比35.50%"
          ],
          "prohibited_wording": [
            "对缺失年份插值",
            "把销量增长率解释为单一政策造成的因果"
          ]
        }
      ],
      "gap_cases": [
        {
          "gap_case_id": "R01-missing-2023",
          "kind": "metric_removal",
          "details": {
            "remove_metric_ids": [
              "r01-cn-nev-sales-2023"
            ]
          },
          "expected_codes": [
            "MISSING_BASE_PERIOD"
          ],
          "expected_missing_periods": [
            "2023"
          ],
          "expected_status": "GAP",
          "note": "缺少2023基期时不得插值或生成2024同比。"
        },
        {
          "gap_case_id": "R01-before-2024-disclosure",
          "kind": "evidence_cutoff",
          "details": {
            "as_of": "2024-12-31"
          },
          "expected_codes": [],
          "expected_missing_periods": [
            "2024"
          ],
          "expected_status": "GAP",
          "note": "截止日当时缺少本案例采用的2024年资料，不能给出三年完整走势或2024年同比。"
        }
      ]
    },
