# 复制为 .env（已被 .gitignore 忽略）后按需填写；启动时必须传入 --env-file .env。
# 全部留空时 backend.app.main 进入零配置演示模式：内存存储 + W5 资料包 + 固定应答 Writer。

# MySQL 业务库（mysql://user:password@host:port/database），需先按 010→011→012→020 应用迁移
DATABASE_URL=

# 兼容 Chat Completions 的模型服务（含 /v1 版本路径）；三项齐备才启用真实模型
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=

# 运行时文件目录（原始资料、检索索引、导出件、图表资源）
RUNTIME_DIR=./runtime

# 管理员上传凭据（POST /admin/session）；留空则管理入口始终 401
ADMIN_CREDENTIAL=

# 模型调用预算（元）与单次调用预留额度；超限停止付费调用并记录 BUDGET_LIMIT
BUDGET_CNY=100.00
PER_CALL_RESERVE_CNY=0.10

# 章节证据包的检索条数上限（1-50）
RETRIEVAL_TOP_K=10
